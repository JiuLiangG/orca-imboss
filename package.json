{
  "name": "orca-imboss",
  "version": "0.1.0",
  "description": "One man company agent",
  "main": "./out/main/index.js",
  "author": "kefroth@outlook.com",
  "homepage": "https://orca-studio.com/imboss/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sethyuan/orca-imboss.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist:local": "pnpm run build && electron-builder --dir",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@modelcontextprotocol/client": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "typebox": "^1.3.21"
  },
  "devDependencies": {
    "@desirecore/electron-vite": "6.0.0-beta.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactutils": "^5.13.3",
    "typescript": "^7.0.2",
    "valtio": "^2.3.2",
    "vite": "^7.3.6"
  }
}
